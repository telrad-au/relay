param(
    [string]$VerifyArtifactPath = "",
    [string]$VerifyDigestPath = "",
    [string]$ClinicRemoteAddress = "LocalSubnet"
)

$ErrorActionPreference = "Stop"
$OutputEncoding = New-Object System.Text.UTF8Encoding($false)
$ArtifactBaseUrl = "@@ARTIFACT_BASE_URL@@"
$UpdateManifestUrl = "@@UPDATE_MANIFEST_URL@@"
$PairingUrl = "@@ENROLLMENT_URL@@"
$TrustedUpdatePublicKey = "@@UPDATE_PUBLIC_KEY@@"
$TrustedWindowsSignerCertificateSha256 = "@@WINDOWS_SIGNER_CERTIFICATE_SHA256@@"
$InstallationManifestBase64 = "@@INSTALLATION_MANIFEST_BASE64@@"
$ServiceName = "TelradRelay"
$ServiceIdentity = "NT SERVICE\$ServiceName"

function Add-TelradCurrentProcessPath {
    param([Parameter(Mandatory = $true)][string]$Path)

    $processPath = [Environment]::GetEnvironmentVariable("Path", "Process")
    if (($processPath -split ";") -contains $Path) {
        return
    }
    $updatedProcessPath = if ([string]::IsNullOrWhiteSpace($processPath)) {
        $Path
    } else {
        "$Path;$processPath"
    }
    [Environment]::SetEnvironmentVariable("Path", $updatedProcessPath, "Process")
}

function Assert-TelradReleaseAuthenticity {
    param(
        [Parameter(Mandatory = $true)][string]$ArtifactPath,
        [Parameter(Mandatory = $true)][string]$ExpectedDigest
    )

    if ($ExpectedDigest -cnotmatch '\A[0-9a-f]{64}\z') {
        throw "Relay checksum metadata is malformed."
    }
    $actualDigest = (Get-FileHash -Algorithm SHA256 -LiteralPath $ArtifactPath).Hash.ToLowerInvariant()
    if ($actualDigest -cne $ExpectedDigest) {
        throw "Relay checksum verification failed."
    }

    if ($TrustedWindowsSignerCertificateSha256 -cnotmatch '\A[0-9a-f]{64}\z') {
        throw "Trusted Windows signer pin is malformed."
    }
    $signature = Get-AuthenticodeSignature -LiteralPath $ArtifactPath
    if ($signature.Status -ne [System.Management.Automation.SignatureStatus]::Valid -or $null -eq $signature.SignerCertificate) {
        throw "Relay Authenticode signature verification failed: $($signature.Status)."
    }

    $sha256 = [Security.Cryptography.SHA256]::Create()
    try {
        $certificateDigest = $sha256.ComputeHash($signature.SignerCertificate.RawData)
    } finally {
        $sha256.Dispose()
    }
    $actualSignerCertificateSha256 = ([BitConverter]::ToString($certificateDigest)).Replace("-", "").ToLowerInvariant()
    if ($actualSignerCertificateSha256 -cne $TrustedWindowsSignerCertificateSha256) {
        throw "Relay was signed by an untrusted publisher certificate."
    }
}

if (($VerifyArtifactPath -eq "") -xor ($VerifyDigestPath -eq "")) {
    throw "VerifyArtifactPath and VerifyDigestPath must be provided together."
}
if ($VerifyArtifactPath -ne "") {
    $verificationDigest = [IO.File]::ReadAllText($VerifyDigestPath)
    Assert-TelradReleaseAuthenticity -ArtifactPath $VerifyArtifactPath -ExpectedDigest $verificationDigest
    Write-Host "Relay release authenticity verified."
    return
}

$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal($identity)
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw "Run PowerShell as Administrator."
}
if ([Runtime.InteropServices.RuntimeInformation]::OSArchitecture -ne [Runtime.InteropServices.Architecture]::X64) {
    throw "This release supports Windows x64 only."
}

$temporary = Join-Path ([IO.Path]::GetTempPath()) ("telrad-relay-" + [Guid]::NewGuid().ToString("N"))
New-Item -ItemType Directory -Path $temporary | Out-Null
try {
    $download = Join-Path $temporary "telrad-relay.exe"
    Invoke-WebRequest "$ArtifactBaseUrl/telrad-relay-windows-amd64.exe" -OutFile $download
    $expected = [string](Invoke-RestMethod "$ArtifactBaseUrl/telrad-relay-windows-amd64.exe.sha256")
    Assert-TelradReleaseAuthenticity -ArtifactPath $download -ExpectedDigest $expected
    $inputData = @{
        config = @{
            schemaVersion = 4
            pairingUrl = $PairingUrl
            controlUrl = ""
            dicomUrl = ""
            hl7Url = ""
            relayId = ""
            credentialPath = "relay-credential.json"
            listenAddress = "0.0.0.0"
            dicomPort = 11112
            hl7Port = 2575
            reportHost = "127.0.0.1"
            reportPort = 2576
            maxConnections = 256
            maxDicomConnections = 128
            maxHl7Connections = 128
            connectTimeoutSeconds = 10
            tlsHandshakeTimeoutSeconds = 15
            responseHeaderTimeoutSeconds = 30
            dicomIdleTimeoutSeconds = 300
            dicomLifetimeSeconds = 7200
            hl7IdleTimeoutSeconds = 0
            hl7LifetimeSeconds = 0
            hl7MaxBytes = 1048576
        }
        trust = @{schemaVersion=1; channel="stable"; manifestUrl=$UpdateManifestUrl; publicKey=$TrustedUpdatePublicKey}
        installation = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($InstallationManifestBase64)) | ConvertFrom-Json
        clinicRemoteAddress = $ClinicRemoteAddress
    }
    # Targets, ACLs, configuration migration, and rollback are handled by the verified binary.
    $inputData | ConvertTo-Json -Depth 20 -Compress | & $download install-native
    if ($LASTEXITCODE -ne 0) { throw "Relay native installation failed." }
    $target = Join-Path ([Environment]::GetFolderPath('ProgramFiles')) "Telrad Relay"
    Add-TelradCurrentProcessPath -Path $target
} finally {
    Remove-Item -Recurse -Force $temporary -ErrorAction SilentlyContinue
}
