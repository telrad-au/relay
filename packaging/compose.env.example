# Use the immutable version and digest from the verified release notes.
TELRAD_RELAY_IMAGE=ghcr.io/telrad-au/relay:2.1.0@sha256:RELEASE_DIGEST

# Official images default to the Telrad production pairing endpoint. Override
# this only for development or a self-hosted Telrad control plane.
# TELRAD_RELAY_PAIRING_URL=https://ingest.dev.app.telrad.com.au/v1/relay/pairing-enrollments

# Export TELRAD_RELAY_PAIRING_TOKEN only in the shell that performs first
# enrollment. Never save it in this file.

# Bind only the clinic-facing host interface. Use 0.0.0.0 only after reviewing
# host firewall scope.
TELRAD_RELAY_BIND_ADDRESS=192.0.2.10

# Use the routable hostname or address of the clinic report destination. See
# docs/container-operations.md for Docker-network and same-host configurations.
TELRAD_RELAY_REPORT_DESTINATION_HOST=192.0.2.20
TELRAD_RELAY_REPORT_DESTINATION_PORT=2576
