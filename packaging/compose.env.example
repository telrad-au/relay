# Use the immutable version and digest from the verified release notes.
TELRAD_RELAY_IMAGE=ghcr.io/telrad-au/relay:VERSION@sha256:RELEASE_DIGEST

# Official images use the Telrad production enrolment endpoint. Override it
# only for development.
# TELRAD_RELAY_ENROLMENT_URL=https://dev.app.telrad.com.au/api/relay/enrolments

# Pair once with a single-use token exported only in that shell, never saved
# in this file:
#   TELRAD_RELAY_PAIRING_TOKEN=... docker compose --env-file relay.env \
#       -f packaging/compose.yml run --rm relay enroll

# Bind only the clinic-facing host interface. Use 0.0.0.0 only after reviewing
# host firewall scope.
TELRAD_RELAY_BIND_ADDRESS=192.0.2.10

# Routable hostname or address of the clinic report receiver (MLLP).
TELRAD_RELAY_REPORT_HOST=192.0.2.20
TELRAD_RELAY_REPORT_PORT=2576
