#!/bin/sh
set -eu

ARTIFACT_BASE_URL="@@ARTIFACT_BASE_URL@@"
UPDATE_MANIFEST_URL="@@UPDATE_MANIFEST_URL@@"
PAIRING_URL="@@ENROLLMENT_URL@@"
UPDATE_PUBLIC_KEY="@@UPDATE_PUBLIC_KEY@@"
UPDATE_PUBLIC_KEY_PEM_BASE64="@@UPDATE_PUBLIC_KEY_PEM_BASE64@@"
INSTALLATION_MANIFEST_BASE64="@@INSTALLATION_MANIFEST_BASE64@@"

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this installer as root (for example, curl ... | sudo sh)." >&2
    exit 1
fi
case "$(uname -m)" in
    x86_64|amd64) artifact_arch="amd64" ;;
    aarch64|arm64) artifact_arch="arm64" ;;
    *) echo "This release supports Linux x86-64 and arm64 only." >&2; exit 1 ;;
esac
for command in base64 curl openssl sha256sum; do
    command -v "$command" >/dev/null 2>&1 || { echo "Missing required command: $command" >&2; exit 1; }
done
umask 077
work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
curl -fsSL "$ARTIFACT_BASE_URL/telrad-relay-linux-$artifact_arch" -o "$work_dir/telrad-relay"
curl -fsSL "$ARTIFACT_BASE_URL/telrad-relay-linux-$artifact_arch.sha256" -o "$work_dir/digest"
curl -fsSL "$ARTIFACT_BASE_URL/telrad-relay-linux-$artifact_arch.sig" -o "$work_dir/signature"
printf '%s' "$UPDATE_PUBLIC_KEY_PEM_BASE64" | base64 -d > "$work_dir/update-public-key.pem"

expected_digest="$(tr -d '\r\n ' < "$work_dir/digest")"
actual_digest="$(sha256sum "$work_dir/telrad-relay" | awk '{print $1}')"
[ "$actual_digest" = "$expected_digest" ] || { echo "Relay checksum verification failed." >&2; exit 1; }
openssl pkeyutl -verify -pubin -inkey "$work_dir/update-public-key.pem" -rawin \
    -in "$work_dir/digest" -sigfile "$work_dir/signature" >/dev/null \
    || { echo "Relay signature verification failed." >&2; exit 1; }

chmod 0700 "$work_dir/telrad-relay"
# Privileged writes and rollback use directory handles inside the verified binary.
{
    printf '{"config":'
    cat <<EOF
{
  "schemaVersion": 5,
  "pairingUrl": "$PAIRING_URL",
  "controlUrl": "",
  "dicomUrl": "",
  "hl7Url": "",
  "relayId": "",
  "credentialPath": "relay-credential.json",
  "listenAddress": "0.0.0.0",
  "dicomPort": 11112,
  "hl7Port": 2575,
  "reportHost": "127.0.0.1",
  "reportPort": 2576,
  "maxConnections": 256,
  "maxDicomConnections": 128,
  "maxHl7Connections": 128,
  "connectTimeoutSeconds": 10,
  "tlsHandshakeTimeoutSeconds": 15,
  "responseHeaderTimeoutSeconds": 30,
  "dicomIdleTimeoutSeconds": 300,
  "dicomLifetimeSeconds": 7200,
  "hl7IdleTimeoutSeconds": 0,
  "hl7LifetimeSeconds": 0,
  "hl7MaxBytes": 1048576
}
EOF
    printf ',"trust":{"schemaVersion":1,"channel":"stable","manifestUrl":"%s","publicKey":"%s"},"installation":' "$UPDATE_MANIFEST_URL" "$UPDATE_PUBLIC_KEY"
    printf '%s' "$INSTALLATION_MANIFEST_BASE64" | base64 -d
    printf '}\n'
} | "$work_dir/telrad-relay" install-native
